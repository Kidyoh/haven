{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://haven-pathways/schema/service-record.json",
  "title": "Pathways service records (one file per region)",
  "description": "Each region file is an array of service records. Every record must trace to a named source; source_text_original keeps the verbatim source text so any translation or normalisation can be audited against it. A field the source does not state is null, never guessed.",
  "type": "array",
  "items": {
    "$ref": "#/definitions/record"
  },
  "definitions": {
    "localisedText": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name_en",
        "name_am",
        "category",
        "services",
        "region",
        "subcity",
        "location_description_en",
        "location_description_am",
        "coordinates",
        "phone",
        "hours",
        "what_to_bring_en",
        "what_to_bring_am",
        "cost",
        "accepts_walk_in",
        "source_name",
        "source_url",
        "source_text_original",
        "verified_on",
        "verified_via",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable, unique, lowercase. Convention: <country>-<region>-<area>-<short>-<nnn>.",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)+$"
        },
        "name_en": {
          "type": "string",
          "minLength": 1
        },
        "name_am": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "one_stop_centre",
            "police",
            "health",
            "legal_aid",
            "shelter",
            "psychosocial",
            "hotline"
          ]
        },
        "services": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "report_filing",
              "medical_care",
              "forensic_exam",
              "emergency_contraception",
              "hiv_pep",
              "sti_treatment",
              "counselling",
              "shelter",
              "legal_advice",
              "court_representation",
              "case_management",
              "child_protection",
              "emergency_response",
              "medical_referral",
              "legal_referral",
              "shelter_referral",
              "police_referral",
              "psychosocial_referral"
            ]
          }
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "subcity": {
          "type": [
            "string",
            "null"
          ],
          "description": "Sub-city / district / woreda. Null when the service is not tied to one area (e.g. a hotline)."
        },
        "location_description_en": {
          "$ref": "#/definitions/localisedText",
          "description": "Primary wayfinding field. Area-level. Never a precise pin for a shelter."
        },
        "location_description_am": {
          "$ref": "#/definitions/localisedText"
        },
        "coordinates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lat",
            "lng"
          ],
          "properties": {
            "lat": {
              "type": [
                "number",
                "null"
              ],
              "minimum": -90,
              "maximum": 90
            },
            "lng": {
              "type": [
                "number",
                "null"
              ],
              "minimum": -180,
              "maximum": 180
            }
          },
          "description": "May be null/null. Shelters and safe houses must be null/null."
        },
        "phone": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\+?[0-9]{3,15}$"
          },
          "description": "Digits only, optional leading +. Empty array when no source states a number."
        },
        "hours": {
          "type": [
            "string",
            "null"
          ],
          "description": "Free text as stated by the source. Null when the source does not say."
        },
        "what_to_bring_en": {
          "$ref": "#/definitions/localisedText"
        },
        "what_to_bring_am": {
          "$ref": "#/definitions/localisedText"
        },
        "cost": {
          "type": "string",
          "enum": [
            "free",
            "paid",
            "unknown"
          ]
        },
        "accepts_walk_in": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "source_name": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "source_text_original": {
          "type": "string",
          "minLength": 1,
          "description": "Verbatim text from the source. Required. Auditors compare every translated or normalised field against this."
        },
        "source_language": {
          "type": "string",
          "description": "BCP-47 tag of source_text_original (e.g. en, am). Defaults to en.",
          "default": "en"
        },
        "verified_on": {
          "type": "string",
          "format": "date"
        },
        "verified_via": {
          "type": "string",
          "enum": [
            "document",
            "institutional_contact",
            "phone"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "unverified",
            "reported_closed"
          ]
        },
        "notes_en": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes_am": {
          "type": [
            "string",
            "null"
          ]
        },
        "placeholder": {
          "type": "boolean",
          "description": "True only for example rows. The UI labels these loudly. Never ship a placeholder that looks like a real service.",
          "default": false
        },
        "additional_sources": {
          "type": "array",
          "description": "Other documents consulted for this record (for audit). The primary source is source_name/source_url.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri"
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      },
      "allOf": [
        {
          "description": "Shelters must never carry precise coordinates.",
          "if": {
            "properties": {
              "category": {
                "const": "shelter"
              }
            }
          },
          "then": {
            "properties": {
              "coordinates": {
                "properties": {
                  "lat": {
                    "type": "null"
                  },
                  "lng": {
                    "type": "null"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
